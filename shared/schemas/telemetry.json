{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BuildingTelemetryPayload",
  "type": "object",
  "required": [
    "timestamp",
    "sensor_id",
    "building_id",
    "zone_id",
    "strain_microstrain",
    "vibration_frequency_hz",
    "ambient_temperature_celsius",
    "structural_load_kn",
    "is_synthetic"
  ],
  "properties": {
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp of measurement"
    },
    "sensor_id": {
      "type": "string",
      "description": "Unique identifier of the physical or virtual sensor"
    },
    "building_id": {
      "type": "string",
      "description": "Identifier of the monitored facility"
    },
    "zone_id": {
      "type": "string",
      "description": "Building structural zone (e.g. core, foundation, roof, wing-a)"
    },
    "strain_microstrain": {
      "type": "number",
      "description": "Measured structural strain in microstrain (um/m)"
    },
    "vibration_frequency_hz": {
      "type": "number",
      "description": "Dominant oscillation frequency in Hz"
    },
    "ambient_temperature_celsius": {
      "type": "number",
      "description": "Ambient environmental temperature in Celsius"
    },
    "structural_load_kn": {
      "type": "number",
      "description": "Dead and live load calculation in kiloNewtons"
    },
    "is_synthetic": {
      "type": "boolean",
      "description": "Indicates whether telemetry originates from digital-twin simulation or physical sensor"
    }
  },
  "additionalProperties": false
}
