# ==============================================================================
# Risk2Relief Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API Base URL (Leave empty for local development with Vite dev-proxy)
# In production (e.g. Render Static Site), set to your deployed backend URL:
# VITE_API_BASE_URL=https://risk2relief-api.onrender.com
VITE_API_BASE_URL=

# Firebase Client Authentication (Web SDK Configuration)
# These are public client-side keys used solely for authentication and token exchange.
# NEVER place Firebase Admin Service Account / Private Keys in the frontend!
VITE_FIREBASE_API_KEY=AIzaSyFakeKeyForExampleDocumentation000
VITE_FIREBASE_AUTH_DOMAIN=risk2relief-demo.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=risk2relief-demo
VITE_FIREBASE_STORAGE_BUCKET=risk2relief-demo.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789012
VITE_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890abcdef
