# ==============================================================================
# Risk2Relief: Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to .env and adjust variables for your local or production setup.
# WARNING: NEVER COMMIT SENSITIVE SECRETS OR PASSWORDS TO SOURCE CONTROL.
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION & GENERAL CONFIGURATION
# ------------------------------------------------------------------------------
ENVIRONMENT=development
PROJECT_NAME="Risk2Relief Building-Management Digital-Twin"
APP_VERSION=0.1.0
DEBUG=true
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# BACKEND API SERVER
# ------------------------------------------------------------------------------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

# ------------------------------------------------------------------------------
# DATABASE (PostgreSQL & SQLAlchemy)
# ------------------------------------------------------------------------------
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=risk2relief_db
POSTGRES_USER=risk2relief_user
POSTGRES_PASSWORD=change_this_in_production_risk2relief_pass
# Formatted connection strings (Async for FastAPI, Sync for Alembic)
DATABASE_URL=postgresql+asyncpg://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DATABASE_URL_SYNC=postgresql+psycopg2://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_SERVER}:${POSTGRES_PORT}/${POSTGRES_DB}
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30

# ------------------------------------------------------------------------------
# REDIS CACHE & CELERY MESSAGE BROKER
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

CELERY_BROKER_URL=redis://${REDIS_HOST}:${REDIS_PORT}/1
CELERY_RESULT_BACKEND=redis://${REDIS_HOST}:${REDIS_PORT}/2

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:8000
VITE_SIMULATION_MODE=true
VITE_APP_TITLE="Risk2Relief Digital-Twin"

# ------------------------------------------------------------------------------
# DIGITAL-TWIN & SAFETY BOUNDARY SPECIFICATIONS
# ------------------------------------------------------------------------------
# The anti-gravity subsystem is an in-silico physics simulation model only.
# No physical actuator or gravity-modifying hardware exists or may be controlled.
SIMULATION_MODE=true
ENABLE_HARDWARE_ACTUATION=false
SIMULATION_TICK_RATE_HZ=10
SAFETY_INTERLOCK_AUTO_SHUTDOWN=true
MAX_STRUCTURAL_STRESS_TOLERANCE_MPA=450.0
CRITICAL_DEFLECTION_THRESHOLD_MM=15.0
